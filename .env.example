# Supabase — server-side only. These are NOT prefixed VITE_ on purpose: that
# prefix is what makes Vite inline a value into the browser bundle, and the
# service-role key bypasses row-level security. It must never ship to a client.
#
# Local dev:  copy to .env.local (gitignored) and fill in.
# Production: set both in Vercel → Settings → Environment Variables.
#
# Find them in Supabase → Project Settings → API Keys. Either the new
# sb_secret_… key or the legacy service_role JWT works; both bypass RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret-key>
