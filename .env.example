# Supabase — server-side only. These are NOT prefixed VITE_ on purpose: that
# prefix is what makes Vite inline a value into the browser bundle, and the
# service-role key bypasses row-level security. It must never ship to a client.
#
# Local dev:  copy to .env.local (gitignored) and fill in.
# Production: set both in Vercel → Settings → Environment Variables.
#
# Find them in Supabase → Project Settings → API Keys. Either the new
# sb_secret_… key or the legacy service_role JWT works; both bypass RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret-key>

# Google tags. Unlike the Supabase keys above, these DO take the VITE_ prefix:
# both are public identifiers meant to be printed in the page, and Vite only
# inlines prefixed values into the browser bundle. Leave either blank and the
# tag is not rendered at all, which keeps local dev out of your reporting.
#
# Analytics → Admin → Data streams → your web stream → Measurement ID.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Only needed for the "HTML tag" method in Search Console. Paste just the
# token from the meta tag's content attribute, not the whole tag.
VITE_GOOGLE_SITE_VERIFICATION=

# Transactional email for the waitlist confirmation, sent through Resend.
# Server-side only, so no VITE_ prefix: this key can send mail as your domain.
# Leave RESEND_API_KEY unset and signups still work, they just send no email,
# which is what you want in dev and in preview builds.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, or the send is rejected.
WAITLIST_FROM_EMAIL="CuspAI <hello@cuspai.io>"
# Where replies land. hello@cuspai.io forwards to the founder's inbox.
WAITLIST_REPLY_TO=hello@cuspai.io

# Admin dashboard at /admin. Server-side only, no VITE_ prefix.
# Unset means the dashboard is sealed and shows nothing. The signing key for
# the session cookie is derived from this value, so changing it signs everyone
# out. Use a long random passphrase.
ADMIN_PASSWORD=
